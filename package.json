{
  "name": "sidecar",
  "productName": "Sidecar",
  "version": "0.1.0",
  "private": true,
  "description": "One quiet place for all your Claude Code sessions.",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "postinstall": "electron-rebuild -f -w better-sqlite3,node-pty",
    "dist": "electron-vite build && electron-builder --mac dir"
  },
  "dependencies": {
    "@fontsource/figtree": "5.3.0",
    "@fontsource/fraunces": "5.3.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-sqlite3": "13.0.3",
    "node-pty": "1.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "4.2.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.17.0",
    "electron-vite": "5.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "local.brittany.sidecar",
    "productName": "Sidecar",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**",
      "**/node_modules/better-sqlite3/**"
    ],
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.developer-tools",
      "identity": null,
      "target": [
        "dir"
      ]
    },
    "npmRebuild": false
  }
}
